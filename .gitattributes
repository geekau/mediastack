* text=auto

# Shell / config / docs should stay LF
*.sh text eol=lf
*.bash text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.txt text eol=lf

# Windows scripts can stay CRLF if you ever add them
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf